# Copy this file to backend/.env and put your real values there.
# .env is in .gitignore — never commit passwords or keys.

# development | test | production (default). Dev-only scripts (seed_demo,
# complete_orders --force) run only in development/test. Keep "development" on your machine.
APP_ENV=development

# Browser origins allowed to call the API (JSON list). The default is the Vite dev server.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Main database (created by database/01_create_roles_and_databases.sql)
DATABASE_URL=postgresql+psycopg://tour_app:change_me@localhost:5432/tour_website

# Database for pytest (its data is wiped on every test run)
TEST_DATABASE_URL=postgresql+psycopg://tour_app:change_me@localhost:5432/tour_website_test

# Print every SQL statement to the console (debugging)
SQL_ECHO=false

# JWT signing key. Generate your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=put-your-generated-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Tour photos: folder (default backend/uploads), size limit per file, photos per tour
# UPLOAD_DIR=C:/path/to/uploads
MAX_IMAGE_MB=5
MAX_IMAGES_PER_TOUR=20

# How often (seconds) the server cancels orders whose seat hold ran out; 0 = off
ORDER_EXPIRY_INTERVAL_SEC=60

# Payments: "stripe" or "mock" (no network). Empty = stripe if STRIPE_SECRET_KEY is set, else mock.
PAYMENT_GATEWAY=mock
# Stripe TEST-mode keys only (Dashboard -> Developers -> API keys). Never commit real values.
STRIPE_SECRET_KEY=sk_test_put-your-test-key-here
# Printed by `stripe listen --forward-to 127.0.0.1:8000/api/payments/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_put-your-webhook-secret-here
# STRIPE_API_VERSION=2026-11-18.endive

# The frontend's address: Stripe returns the client to its /payment/success and /payment/cancel
# pages. Empty = http://localhost:5173 (the Vite dev server) in development/test; with
# APP_ENV=production the API refuses to start without it.
FRONTEND_URL=
API_BASE_URL=http://127.0.0.1:8000

# Bank transfer details shown to clients (placeholders)
BANK_RECIPIENT=Your company name
BANK_IBAN=UA000000000000000000000000000
BANK_EDRPOU=00000000
BANK_NAME=Your bank
MAX_STATEMENT_MB=10

# Order processing: private order documents (vouchers, tickets, client's evidence)
MAX_DOCUMENT_MB=10
MAX_DOCUMENTS_PER_ORDER=20
MAX_CANCEL_EVIDENCE_FILES=5
# Finished trips become "completed" the day after end_date in this zone; check interval (0 = off)
BUSINESS_TIMEZONE=Europe/Kyiv
ORDER_COMPLETION_INTERVAL_SEC=3600

# Reviews: photos per review (form 4.6.1.4 allows up to 10) and size of each photo
MAX_REVIEW_PHOTOS=10
MAX_REVIEW_PHOTO_MB=5
